@@ -1686,6 +1731,29 @@
                                                 q_node_weights)
             trace["c_chance_nm"] = _chance_mass(c_chance, c_sigs,
                                                 c_node_weights)
+
+    # [PHASE2 B7] The incomparable relations' mass leaves the
+    # denominator (a relation with no counterpart is not evidence
