+        if trace is not None:
+            trace["incomparable_core_edges"] = len(_skipped_c_mass_terms)
+            trace["incomparable_query_edges"] = len(_q_skipped)
 
     # [Kc2] The success-path trace write stays here
     if trace is not None:
