+    # core edge stays in: it was matched.
+    if _skip_incomparable and (_skipped_c_mass_terms or _skipped_q_keys):
+        c_edge_total = max(0.0, c_edge_total - math.fsum(_skipped_c_mass_terms))
+        # [DETERMINISM] the skipped query edges are NOT sorted: a key
