     # [STAGE 10 / AUDIT B3] THE FACILITATION OVERFLOWS THE TOTAL -- AND THAT
     # IS PINNED.  The factor (1 + log2(n+1)) multiplies the MATCHED edge mass
     # but not the edge totals, so one matched edge with one measured axis
@@ -1656,7 +1699,9 @@
 
     if trace is not None:
         trace["c_node_total"] = c_node_total
