# [PHASE 2] 0005_count_absent_consensus_voters
#
# CLAIM ID: D7 (the consensus drops the absent voters and misaligns the
#              weights).
# 
# MECHANISM: `fuzzy_consensus` keeps the ABSENCE MASK: a reference slot that
# an exemplar did not fill is an ABSTENTION (None), not a shorter voter list.
# `slot_vote` accepts the abstention: the voter's weight stays in the
# denominator (so the support is over ALL the voters) while it contributes no
# value.  The row builder keeps one entry per voter, so the weights stay
# aligned to the exemplar index -- the second half of the defect (the old code
# zipped the surviving values with the FIRST weights).
# 
# PRE-REGISTERED CONSTANTS: none.
# 
# GATING FLAG: MATCH_CONSENSUS_COUNT_ABSTENTIONS (default OFF).
# 
# THE PIN: tests/matcher/test_phase2_flagged_mechanisms.py::
#         test_d7_the_abstentions_are_counted_only_when_the_flag_is_on
#         (2 of 5 matching voters -> the support 0.400 over 5 voters)
# 
# DEPENDENCIES: 0001 (the flag).
# 
# MEASURED: the mechanism is confirmed by the audit's construction (2 of 5 ->
# the support 1.000 over 2 voters; the expected 0.400 over 5).  The consensus
# path is not in the nine-pair correspondence path, so its effect is in the
# core construction.
#
# apply from the repository root: git apply -p1 0005_count_absent_consensus_voters.patch
diff --git a/src/matching/consensus.py b/src/matching/consensus.py
--- a/src/matching/consensus.py
+++ b/src/matching/consensus.py
@@ -120,18 +120,29 @@
 
 
 def slot_vote(
-    values: Sequence[float],
+    values: Sequence[Optional[float]],
     *,
     weights: Optional[Sequence[float]] = None,
     identity: bool = False,
     cycle: Optional[float] = None,
+    n_voters: Optional[int] = None,
 ) -> SlotVote:
     """Weighted vote for one slot. See module docstring for the semantics."""
-    pairs = [(float(v), w) for v, w in zip(values, _weights(len(values), weights))
-             if math.isfinite(float(v)) and w > 0.0]
+    all_w = _weights(len(values), weights)
+    pairs = [(float(v), w) for v, w in zip(values, all_w)
+             if v is not None and math.isfinite(float(v)) and w > 0.0]
     if not pairs:
         return SlotVote(0.0, 0.0, 1.0, 0.0)
     total_w = sum(w for _, w in pairs)
+    # [PHASE2 D7] The support is over ALL the voters, including the
+    # abstentions: an exemplar that did not fill the slot is a voter
+    # that did not answer, and it must lower the support (otherwise
+    # 2 of 5 matching voters report a support of 1.000 -- a unanimity
+    # that does not exist).  With n_voters unset the historical
+    # denominator (the voters that answered) is kept.
+    total_all = sum(all_w) if n_voters is None else sum(all_w[:n_voters])
+    if total_all <= 0.0:
+        total_all = total_w
 
     if identity:
         # categorical weighted mode; ties -> smaller value
@@ -143,7 +154,7 @@
             sorted(counts),
             key=lambda k: (-counts[k], k),
         )
-        support = counts[mode] / total_w
+        support = counts[mode] / total_all
         return SlotVote(float(mode), support, 1.0 - support, total_w)
 
     if cycle is not None and cycle > 0.0:
@@ -166,7 +177,7 @@
     mean = sum(v * w for v, w in pairs) / total_w
     medoid = min(pairs, key=lambda vw: (abs(vw[0] - mean), vw[0]))[0]
     near = sum(w for v, w in pairs if abs(v - medoid) <= 0.5)
-    support = near / total_w
+    support = near / total_all
     return SlotVote(float(medoid), support, 1.0 - support, total_w)
 
 
